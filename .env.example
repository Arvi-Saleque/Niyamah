# ──────────────────────────────────────────────────────
#  Niyamah — Environment Variables
#  Copy this file to .env.local and fill in real values.
#  NEVER commit .env.local to version control.
# ──────────────────────────────────────────────────────


# ── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default store ID (used in single-tenant mode / local dev)
NEXT_PUBLIC_STORE_ID=


# ── Database (Neon PostgreSQL) ─────────────────────────
DATABASE_URL=


# ── Auth.js v5 ─────────────────────────────────────────
AUTH_SECRET=                        # openssl rand -base64 32
AUTH_URL=http://localhost:3000

# Google OAuth (optional for v1 — social login)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=


# ── Upstash Redis (optional — rate limiting & password reset tokens) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Meilisearch (OPTIONAL — v1 uses PostgreSQL FTS; leave blank) ──────
# MEILISEARCH_HOST=
# MEILISEARCH_API_KEY=


# ── Cloudinary ─────────────────────────────────────────
# Used server-side by src/lib/cloudinary/index.ts
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used client-side (Next.js Image component, etc.)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=


# ── Resend (transactional email) ───────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@niyamah.com.bd


# ── Inngest (background jobs) ──────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


# ── Analytics (all optional) ───────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Server-side Meta Conversions API
META_ACCESS_TOKEN=
META_PIXEL_ID=


# ── Ops / Alerts ───────────────────────────────────────
HIGH_RISK_ALERT_EMAIL=


# ── Seed ───────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@niyamah.com.bd
SEED_ADMIN_PASSWORD=change-this-before-seeding
